# ASMA Accordi 2.0 - Esempio di Configurazione Segreti (.streamlit/secrets.toml)
# Da incollare nella sezione "Secrets" delle impostazioni su Streamlit Community Cloud

# 1. Controllo Accessi Musicisti Band (Pseudonimi: Sentimental, Maurino, Red, Mingo, Cico, Titho)
[access]
allowed_emails = [
  "danyposta@gmail.com",
  "acicchelli65@gmail.com",
  "maurobovolenta4@gmail.com",
  "marcoerario2@gmail.com",
  "gv.drummer69@gmail.com",
  "titholola@gmail.com"
]
admin_emails = ["danyposta@gmail.com"]

# 2. Autenticazione Google (OAuth 2.0 / OpenID Connect)
[google_auth]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "GOCSPX-YOUR_GOOGLE_CLIENT_SECRET"
redirect_uri = "https://asma-app.streamlit.app"

# 3. Sincronizzazione Cloud GitHub Gist (Backup automatico archivio)
[github]
token = "ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
gist_id = "YOUR_GITHUB_GIST_ID"

# 4. Servizio AI Opzionale (Google Gemini Free Tier)
[ai]
gemini_api_key = "AIzaSy_YOUR_OPTIONAL_GEMINI_API_KEY"
mode = "FREE" # "OFF", "FREE", "PREMIUM"
