# ASMA Accordi 2.0 - Esempio di Configurazione Segreti (.streamlit/secrets.toml)
# Rinominare questo file in 'secrets.toml' e inserire le credenziali della band.

# Autenticazione Google (OAuth 2.0 / OpenID Connect)
[google_auth]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "GOCSPX-YOUR_GOOGLE_CLIENT_SECRET"
redirect_uri = "https://your-band-app.streamlit.app"

# Sincronizzazione GitHub Gist
[github]
token = "ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
gist_id = "YOUR_GITHUB_GIST_ID"

# Servizio AI Opzionale (Google Gemini Free Tier)
[ai]
gemini_api_key = "AIzaSy_YOUR_OPTIONAL_GEMINI_API_KEY"
mode = "FREE" # "OFF", "FREE", "PREMIUM"
