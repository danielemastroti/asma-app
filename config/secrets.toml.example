# ASMA Accordi 2.0 - Configurazione Segreti e Credenziali (config/secrets.toml)
# Copia questo file in config/secrets.toml oppure imposta le variabili d'ambiente di sistema.

[turso]
database_url = "libsql://asma-db-YOUR_DATABASE.turso.io"
auth_token = "eyJhbGciOi..."

[auth]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "GOCSPX-YOUR_GOOGLE_CLIENT_SECRET"
redirect_uri = "https://asma-app.onrender.com"

[github]
token = "ghp_YOUR_PERSONAL_ACCESS_TOKEN"
gist_id = "YOUR_GIST_ID"

[ai]
gemini_api_key = "AIzaSy_YOUR_OPTIONAL_GEMINI_API_KEY"
